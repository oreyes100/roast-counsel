[Unit]
Description=Roast Counsel AI decision room
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roast-counsel
Group=roast-counsel
WorkingDirectory=/opt/roast-counsel/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/roast-counsel.env
ExecStart=/usr/bin/node /opt/roast-counsel/current/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/roast-counsel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
